### Test fixtures ###
# Keep the inputs — .tcl scripts, HDL sources, .xdc constraints, session logs, READMEs.
# Ignore everything Vivado regenerates from them: one block-design build writes >170 MB.
test_files/**/*.cache/
test_files/**/*.gen/
test_files/**/*.runs/
test_files/**/*.sim/
test_files/**/*.srcs/
test_files/**/*.hw/
test_files/**/*.ip_user_files/
test_files/**/.Xil/

# Project descriptors embed absolute paths from the machine that built them.
test_files/**/*.xpr
test_files/**/*.jou
test_files/**/*.str

# Vivado's own scratch logs. Redirected session logs (build_bd.log, run_impl.log)
# are deliberately NOT matched here — they are the record of what the AI did.
test_files/**/vivado*.log
test_files/**/vivado*.jou
test_files/**/hs_err_pid*.log

test_files/.idea/
*viva_ip_exec
*viva_prj_exec

### Vendor documentation ###
# UG835 is a 36 MB AMD PDF and is only an input to tools/extract_ug835.py — the
# generated catalogue under src/main/resources/vivado/ is what ships. Download it
# yourself if you need to regenerate.
UG835.pdf
docs/*.pdf
# Local Vivado part/board selection is per-developer.
.idea/vivadoSettings.xml
